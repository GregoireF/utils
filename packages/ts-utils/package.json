{
  "name": "@gregoiref/ts-utils",
  "version": "0.0.1",
  "description": "Typed TypeScript utilities — pick, omit, groupBy, deepMerge and more — zero dependencies",
  "keywords": ["typescript", "utils", "helpers", "pick", "omit", "zero-dependencies"],
  "homepage": "https://github.com/GregoireF/utils/tree/main/packages/ts-utils",
  "repository": {
    "type": "git",
    "url": "https://github.com/GregoireF/utils.git",
    "directory": "packages/ts-utils"
  },
  "bugs": { "url": "https://github.com/GregoireF/utils/issues" },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./array": {
      "import": "./dist/array.js",
      "types": "./dist/array.d.ts"
    },
    "./object": {
      "import": "./dist/object.js",
      "types": "./dist/object.d.ts"
    },
    "./function": {
      "import": "./dist/function.js",
      "types": "./dist/function.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/**/*.test.*"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "biome check src",
    "typecheck": "tsc",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@gregoiref/biome-config": "workspace:*",
    "@gregoiref/tsconfig": "workspace:*",
    "@gregoiref/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "^4.0.0",
    "vitest": "^4.0.0"
  }
}
