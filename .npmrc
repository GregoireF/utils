# @gregoiref packages are published to the public npm registry.
# The NPM_TOKEN secret in GitHub Actions is used for authentication.
@gregoiref:registry=https://registry.npmjs.org

# Attach provenance attestations when publishing from CI.
# Allows consumers to verify the package was built from this exact source.
provenance=true

# Enforce strict lockfile — never generate a new lockfile, fail if out of sync.
# Overridden locally by pnpm (this setting is for npm/npx compatibility).
# pnpm uses --frozen-lockfile in CI via the install command directly.

# Suppress the funding message
fund=false
